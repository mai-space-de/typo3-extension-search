<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages"
          date="2025-01-01T00:00:00Z" product-name="mai_search">
        <header/>
        <body>
            <trans-unit id="index.title">
                <source>Search Index Management</source>
                <target>Suchindex-Verwaltung</target>
            </trans-unit>
            <trans-unit id="index.solrCores">
                <source>Search Indexes</source>
                <target>Such-Indizes</target>
            </trans-unit>
            <trans-unit id="index.indexers">
                <source>Registered Indexers</source>
                <target>Registrierte Indexer</target>
            </trans-unit>
            <trans-unit id="index.languages">
                <source>Languages Indexed</source>
                <target>Indexierte Sprachen</target>
            </trans-unit>
            <trans-unit id="index.totalDocuments">
                <source>Indexed Documents</source>
                <target>Indexierte Dokumente</target>
            </trans-unit>
            <trans-unit id="index.actions.title">
                <source>Actions</source>
                <target>Aktionen</target>
            </trans-unit>
            <trans-unit id="index.reindex.title">
                <source>Re-index all content across all cores</source>
                <target>Alle Inhalte über alle Cores neu indexieren</target>
            </trans-unit>
            <trans-unit id="index.reindex.button">
                <source>Re-index All</source>
                <target>Alles neu indexieren</target>
            </trans-unit>
            <trans-unit id="index.clear.title">
                <source>Clear the entire search index</source>
                <target>Den gesamten Suchindex leeren</target>
            </trans-unit>
            <trans-unit id="index.clear.button">
                <source>Clear Index</source>
                <target>Index leeren</target>
            </trans-unit>
            <trans-unit id="index.clear.confirm">
                <source>Are you sure you want to clear the entire search index? This action cannot be undone.</source>
                <target>Soll der gesamte Suchindex wirklich geleert werden? Diese Aktion kann nicht rückgängig gemacht werden.</target>
            </trans-unit>
            <trans-unit id="index.clearAnswerCache.title">
                <source>Clear cached RAG answers without rebuilding the search index</source>
                <target>Zwischengespeicherte RAG-Antworten leeren, ohne den Suchindex neu aufzubauen</target>
            </trans-unit>
            <trans-unit id="index.clearAnswerCache.button">
                <source>Clear Answer Cache</source>
                <target>Antwort-Cache leeren</target>
            </trans-unit>
            <trans-unit id="index.clearAnswerCache.confirm">
                <source>Are you sure you want to clear all cached RAG answers?</source>
                <target>Sollen wirklich alle zwischengespeicherten RAG-Antworten gelöscht werden?</target>
            </trans-unit>
            <trans-unit id="index.provision.title">
                <source>Create the Solr cores or Meilisearch indexes the active backend needs</source>
                <target>Die vom aktiven Backend benötigten Solr-Cores oder Meilisearch-Indizes anlegen</target>
            </trans-unit>
            <trans-unit id="index.provision.button">
                <source>Provision Infrastructure</source>
                <target>Infrastruktur einrichten</target>
            </trans-unit>
            <trans-unit id="index.inspect.title">
                <source>Index Inspection</source>
                <target>Indexprüfung</target>
            </trans-unit>
            <trans-unit id="index.inspect.coreLabel">
                <source>Index: %1$s (%2$s)</source>
                <target>Index: %1$s (%2$s)</target>
            </trans-unit>
            <trans-unit id="index.inspect.documentsInCore">
                <source>Total documents: %1$d</source>
                <target>Dokumente insgesamt: %1$d</target>
            </trans-unit>
            <trans-unit id="index.inspect.type">
                <source>Document Type</source>
                <target>Dokumenttyp</target>
            </trans-unit>
            <trans-unit id="index.inspect.count">
                <source>Count</source>
                <target>Anzahl</target>
            </trans-unit>
            <trans-unit id="index.inspect.noData">
                <source>No inspection data available. The active search backend may be unreachable or the index is empty.</source>
                <target>Keine Prüfdaten verfügbar. Das aktive Such-Backend ist möglicherweise nicht erreichbar oder der Index ist leer.</target>
            </trans-unit>
            <trans-unit id="index.coreMapping.title">
                <source>Index Mapping</source>
                <target>Index-Zuordnung</target>
            </trans-unit>
            <trans-unit id="index.coreMapping.language">
                <source>Language Code</source>
                <target>Sprachcode</target>
            </trans-unit>
            <trans-unit id="index.coreMapping.core">
                <source>Index</source>
                <target>Index</target>
            </trans-unit>
            <trans-unit id="index.noCoreMapping">
                <source>No per-language index mapping configured. Using default index.</source>
                <target>Keine sprachspezifische Index-Zuordnung konfiguriert. Es wird der Standard-Index verwendet.</target>
            </trans-unit>
            <trans-unit id="index.indexerTypes.title">
                <source>Registered Indexer Types</source>
                <target>Registrierte Indexer-Typen</target>
            </trans-unit>
            <trans-unit id="index.indexerTypes.type">
                <source>Type</source>
                <target>Typ</target>
            </trans-unit>
            <trans-unit id="index.noIndexers">
                <source>No indexers are currently registered.</source>
                <target>Es sind derzeit keine Indexer registriert.</target>
            </trans-unit>
            <trans-unit id="index.queue.title">
                <source>View the async index queue</source>
                <target>Die asynchrone Index-Warteschlange anzeigen</target>
            </trans-unit>
            <trans-unit id="index.queue.button">
                <source>Index Queue</source>
                <target>Index-Warteschlange</target>
            </trans-unit>
            <trans-unit id="index.prompts.title">
                <source>RAG Prompts</source>
                <target>RAG-Prompts</target>
            </trans-unit>
            <trans-unit id="index.prompts.hint">
                <source>Edit these texts in Sites → Site Configuration → Settings (Search). Changing a prompt invalidates cached answers because the prompt is part of the cache key.</source>
                <target>Diese Texte bearbeiten Sie unter Sites → Site Configuration → Settings (Suche). Eine Prompt-Änderung invalidiert gecachte Antworten, weil der Prompt Teil des Cache-Keys ist.</target>
            </trans-unit>
            <trans-unit id="index.prompts.noSite">
                <source>No site could be resolved. Showing code defaults. Select a page in the page tree or activate the mai-search site set.</source>
                <target>Keine Site gefunden. Es gelten die Code-Defaults. Seite im Seitenbaum wählen oder das mai-search Site-Set aktivieren.</target>
            </trans-unit>
            <trans-unit id="index.prompts.usingDefault">
                <source>Using code defaults</source>
                <target>Code-Defaults aktiv</target>
            </trans-unit>
            <trans-unit id="index.prompts.usingOverride">
                <source>Using site settings override</source>
                <target>Site-Settings-Override aktiv</target>
            </trans-unit>
            <trans-unit id="index.prompts.systemPrompt">
                <source>System prompt</source>
                <target>System-Prompt</target>
            </trans-unit>
            <trans-unit id="index.prompts.userTemplate">
                <source>User template ({context}, {query})</source>
                <target>User-Vorlage ({context}, {query})</target>
            </trans-unit>
            <trans-unit id="queue.title">
                <source>Search Index Queue</source>
                <target>Such-Index-Warteschlange</target>
            </trans-unit>
            <trans-unit id="queue.autoRefresh">
                <source>Counts and recent jobs refresh automatically every few seconds.</source>
                <target>Zähler und letzte Jobs aktualisieren sich automatisch alle paar Sekunden.</target>
            </trans-unit>
            <trans-unit id="queue.progress.title">
                <source>Queue progress</source>
                <target>Warteschlangen-Fortschritt</target>
            </trans-unit>
            <trans-unit id="queue.progress.jobsLabel">
                <source>jobs in queue</source>
                <target>Jobs in der Warteschlange</target>
            </trans-unit>
            <trans-unit id="queue.pending">
                <source>Pending</source>
                <target>Ausstehend</target>
            </trans-unit>
            <trans-unit id="queue.processing">
                <source>Processing</source>
                <target>In Bearbeitung</target>
            </trans-unit>
            <trans-unit id="queue.done">
                <source>Done</source>
                <target>Erledigt</target>
            </trans-unit>
            <trans-unit id="queue.failed">
                <source>Failed</source>
                <target>Fehlgeschlagen</target>
            </trans-unit>
            <trans-unit id="queue.process.title">
                <source>Process a batch of pending queue items now</source>
                <target>Jetzt ein Batch ausstehender Warteschlangeneinträge verarbeiten</target>
            </trans-unit>
            <trans-unit id="queue.process.button">
                <source>Process Queue Now</source>
                <target>Warteschlange jetzt verarbeiten</target>
            </trans-unit>
            <trans-unit id="queue.back">
                <source>Back to Index</source>
                <target>Zurück zur Übersicht</target>
            </trans-unit>
            <trans-unit id="queue.recent.title">
                <source>Recent Queue Activity</source>
                <target>Letzte Warteschlangenaktivität</target>
            </trans-unit>
            <trans-unit id="queue.recent.table">
                <source>Table</source>
                <target>Tabelle</target>
            </trans-unit>
            <trans-unit id="queue.recent.recordUid">
                <source>Record UID</source>
                <target>Datensatz-UID</target>
            </trans-unit>
            <trans-unit id="queue.recent.operation">
                <source>Operation</source>
                <target>Vorgang</target>
            </trans-unit>
            <trans-unit id="queue.recent.status">
                <source>Status</source>
                <target>Status</target>
            </trans-unit>
            <trans-unit id="queue.recent.queuedDate">
                <source>Queued</source>
                <target>Eingereiht</target>
            </trans-unit>
            <trans-unit id="queue.recent.processedDate">
                <source>Processed</source>
                <target>Verarbeitet</target>
            </trans-unit>
            <trans-unit id="queue.recent.error">
                <source>Error</source>
                <target>Fehler</target>
            </trans-unit>
            <trans-unit id="queue.recent.noData">
                <source>The queue is empty.</source>
                <target>Die Warteschlange ist leer.</target>
            </trans-unit>
        </body>
    </file>
